// Powerlifting Training Log — Prisma schema
// Roles (Coach/Athlete), exercise catalog with impact coefficients,
// per-exercise 1RM, dynamic set entries, fatigue coefficient curve.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (transaction-mode, pgbouncer) connection — used at runtime by
  // every query the app makes (Vercel serverless functions).
  url       = env("DATABASE_URL")
  // Direct (session-mode) connection — only used by `prisma migrate`/`db
  // push`, which need a non-pooled connection. Not read at runtime.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  // "COACH" | "ATHLETE" — plain string because SQLite (local dev) doesn't support
  // Prisma enums. Switch back to `enum Role` once back on Postgres for production.
  role          String    @default("ATHLETE")
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  // "Упрощённый режим" checkbox (Микроцикл week view + single-day Workout
  // view) — stored per-user rather than in localStorage so it survives an
  // app reload or signing in from a different browser/device.
  simplifiedView Boolean  @default(false)
  // "Компактный режим" checkbox (single-day Workout view) — groups
  // consecutive same weight+reps sets into one "вес / countхповт / %1ПМ"
  // line instead of a row per set. Same per-user persistence reasoning as
  // simplifiedView above.
  compactView    Boolean  @default(false)

  // If this user is an athlete, they have exactly one profile
  athleteProfile AthleteProfile?

  // If this user is a coach, they manage many athlete profiles
  coachedAthletes AthleteProfile[] @relation("CoachAthletes")

  // Required by @auth/prisma-adapter for the database session strategy.
  accounts Account[]
  sessions Session[]
}

// The following three models are the standard NextAuth/Auth.js Prisma adapter
// schema — required for Google sign-in + database sessions to work at all.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AthleteProfile {
  id     String  @id @default(uuid())
  // Null until the athlete accepts an invite and signs in for the first time —
  // a coach can create this profile (and a plan for it) before that happens.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  coachId String?
  coach   User?   @relation("CoachAthletes", fields: [coachId], references: [id])

  // Populated for a coach-created placeholder, before `user` exists.
  displayName String?
  inviteEmail String?
  inviteToken String? @unique
  // "NONE" | "PENDING" | "ACCEPTED" — plain string, not an enum, same reason as
  // User.role: SQLite (local dev) doesn't support Prisma enums.
  inviteStatus String    @default("NONE")
  invitedAt    DateTime?

  // Set when a coach "deletes" an athlete who already has at least one plan
  // (Cycle) — instead of destroying real training data, the profile is
  // hidden from the main roster but kept intact and restorable. Only an
  // already-archived athlete can be permanently deleted (from /athletes/archive).
  // Null = active/visible on the normal roster.
  archivedAt DateTime?

  oneRepMaxes  Athlete1RM[]
  cycles       Cycle[]
  supplements  Supplement[]
  periods      Period[]
  changeLogs   ChangeLog[]
  competitions Competition[]

  createdAt DateTime @default(now())

  @@index([coachId])
}

// Top level of the season-periodization hierarchy ("Периоды" — e.g.
// "Подготовительный"/"Соревновательный"/"Переходной"), each with its own
// date range set independently by the coach (not derived from the
// mesocycles inside it). Replaces the earlier Cycle.periodType tag —
// a Period is now a real entity so several Cycles (mesocycles) can be
// grouped under it via the Stages in between, and its span can be edited
// with a date-range picker directly.
model Period {
  id        String         @id @default(uuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime       @default(now())

  stages Stage[]

  @@index([athleteId])
}

// Middle level ("Этапы" — e.g. "Обще-подготовительный"). Always belongs to
// exactly one Period; a Period can have several Stages. Own date range,
// independent of the Мезоциклы attached under it.
model Stage {
  id        String   @id @default(uuid())
  periodId  String
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  mesocycles Mesocycle[]

  @@index([periodId])
}

// Bottom two levels of the periodization sheet ("Мезоциклы"/"Микроциклы") —
// deliberately a separate, lightweight entity from Cycle/Microcycle (the
// real training-plan models used everywhere else in the app). A coach may
// well want to sketch out a season's Период/Этап/Мезоцикл/Микроцикл shape
// before any actual trainable plan exists for it, and periodization data
// shouldn't be entangled with — or accidentally deleted alongside — a real
// plan's workouts/exercises/sets. Just a name + duration, same free-text-
// preset pattern as everything else in this hierarchy.
model Mesocycle {
  id        String   @id @default(uuid())
  stageId   String
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  weeks     Int
  createdAt DateTime @default(now())

  microcycles PeriodizationMicrocycle[]

  @@index([stageId])
}

model PeriodizationMicrocycle {
  id             String    @id @default(uuid())
  mesocycleId    String
  mesocycle      Mesocycle @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)
  weekNumber     Int
  microcycleType String?

  @@unique([mesocycleId, weekNumber])
}

// Athlete-managed supplement intake log ("Спортпит") — a name plus an
// intake period (startDate required, endDate null while still taking it).
// Purely informational, not linked to any training-load calculation.
model Supplement {
  id        String         @id @default(uuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime?
  notes     String?
  createdAt DateTime       @default(now())

  @@index([athleteId])
}

// Соревнования — an athlete's competition results log. One row per meet:
// name, date, weight class and the weigh-in bodyweight, plus the best
// accepted attempt in each of the three lifts. Each lift is independently
// nullable (a no-lift/bombout in one shouldn't block recording the other
// two, and a coach might log a meet before all three results are in). Total
// isn't a stored column — it's derived from squat+bench+deadlift wherever
// all three are present, same as the Мои спортсмены main-lifts widget, so
// it can never drift out of sync with the three numbers it's built from.
model Competition {
  id          String         @id @default(uuid())
  athleteId   String
  athlete     AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  name        String
  date        DateTime
  weightClass String?
  bodyweight  Float?
  squat       Float?
  bench       Float?
  deadlift    Float?
  place       Int?
  notes       String?
  createdAt   DateTime       @default(now())

  @@index([athleteId])
}

// Reference catalog of exercises (seeded from the "Коэффициенты" sheet).
// impactCoefficient = biomechanical load-on-organism weight used in the fatigue index.
model ExerciseCatalog {
  id                String  @id @default(uuid())
  name              String  @unique
  category          String? // e.g. "Приседания", "Жим", "Тяга", "Вспомогательное"
  impactCoefficient Float   @default(1.0)
  // "BASE" | "SPP" | "GPP" — Базовые / СФП / ОФП training-block classification.
  // A separate axis from `category` (movement pattern): a coach assigns this
  // manually from the admin exercise page ("move" an exercise into a block).
  // Null until assigned — plain string, not an enum, same reasoning as
  // User.role/AthleteProfile.inviteStatus elsewhere in this schema.
  trainingGroup     String?

  oneRepMaxes     Athlete1RM[]
  exerciseEntries ExerciseEntry[]
}

// Per-athlete, per-exercise 1RM. Any exercise in the catalog can have a tracked 1RM,
// not just the 3 competition lifts.
model Athlete1RM {
  id         String          @id @default(uuid())
  athleteId  String
  athlete    AthleteProfile  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   ExerciseCatalog @relation(fields: [exerciseId], references: [id])
  value      Float
  updatedAt  DateTime        @updatedAt

  @@unique([athleteId, exerciseId])
  @@index([exerciseId])
}

// Legacy non-linear fatigue coefficient curve from the original Excel "F" sheet.
// No longer used to compute "Индекс усталости" (replaced by RpeTable below, per
// the coach's RPE chart) — left in place unused rather than risk a destructive
// migration mid-session; safe to drop later.
model FatigueCoefficient {
  id          String @id @default(uuid())
  percent1rm  Float  @unique // e.g. 0.75 = 75% of 1RM
  coefficient Float
}

// RPE chart (Reactive Training Systems style): for a given number of reps and an
// "ИУ" (RPE, 1-10) value, the %1RM it corresponds to. Seeded from the coach's own
// chart (prisma/seedRpeTable.ts). Not every (reps, rpe) combination is populated —
// the source chart only tabulates practically-used combinations.
model RpeTable {
  id         String @id @default(uuid())
  reps       Int
  rpe        Float
  percent1rm Float

  @@unique([reps, rpe])
}

// A training plan ("Мезоцикл" in the old spreadsheet sense, but — unlike the
// Mesocycle model above — deliberately not tied into the Период/Этап
// periodization hierarchy at all. See Mesocycle's comment for why the two
// are kept separate.
model Cycle {
  id        String         @id @default(uuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  weeks     Int
  createdAt DateTime       @default(now())

  microcycles Microcycle[]
  changeLogs  ChangeLog[]
}

model Microcycle {
  id         String @id @default(uuid())
  cycleId    String
  cycle      Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  weekNumber Int

  workouts Workout[]

  @@unique([cycleId, weekNumber])
}

model Workout {
  id            String     @id @default(uuid())
  microcycleId  String
  microcycle    Microcycle @relation(fields: [microcycleId], references: [id], onDelete: Cascade)
  scheduledDate DateTime
  dayNumber     Int // 1..N within the microcycle

  exerciseEntries ExerciseEntry[]

  @@index([microcycleId])
}

model ExerciseEntry {
  id         String          @id @default(uuid())
  workoutId  String
  workout    Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   ExerciseCatalog @relation(fields: [exerciseId], references: [id])
  orderIndex Int             @default(0)
  multiplier Float           @default(1.0) // "Множ" — e.g. dumbbell x2
  // Historical 1RM snapshot used for this workout. Updating an athlete's
  // current 1RM only changes this field for the workout being edited and
  // later workouts, so completed/past plans keep their original percentages.
  oneRepMax  Float?
  // Marked when the athlete didn't get to this exercise (ran out of time, gym was
  // busy, etc.) — distinct from just having zero sets logged, which could equally
  // mean "not filled in yet". Doesn't affect tonnage/КПШ/etc, purely a status flag.
  skipped    Boolean         @default(false)

  sets SetEntry[]

  @@index([workoutId])
  @@index([exerciseId])
}

// Dynamic set list — replaces the Excel model's fixed 6-block columns.
// UI adds rows via "+ Добавить подход".
model SetEntry {
  id              String        @id @default(uuid())
  exerciseEntryId String
  exerciseEntry   ExerciseEntry @relation(fields: [exerciseEntryId], references: [id], onDelete: Cascade)
  setNumber       Int
  weight          Float
  reps            Int
  rpe             Float?
  // Checked off by the coach/athlete once the set has actually been performed
  // (vs. just planned) — small checkbox next to the set number in the UI.
  completed       Boolean       @default(false)

  @@index([exerciseEntryId])
}

// Durable audit trail of athlete-made edits to their own plan (weight/reps
// changes, sets removed, exercises added/removed) — the coach's "История"
// screen reads this, and the workout view uses `seenByCoach` to highlight
// whatever changed since the coach last looked. Complements (doesn't
// replace) the fire-and-forget email digest in lib/email.ts: that one is an
// in-memory buffer that's lost on a server restart and gives no way to look
// back later, this is the persisted source of truth.
//
// Deliberately no FK to Workout/ExerciseEntry/SetEntry — history must
// survive even after the workout/exercise/set it refers to is later deleted,
// so those ids (and the display fields alongside them) are stored as plain
// denormalized values, same as ChangeEvent in lib/email.ts already does for
// the digest email.
model ChangeLog {
  id        String         @id @default(uuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  // Which plan this edit happened in — the History screen is scoped per-Cycle
  // (not athlete-wide) so a coach juggling several plans for one athlete
  // isn't stuck guessing which plan a given change belongs to. Nullable only
  // because workoutId itself is nullable in principle; every real write
  // (recordChangeLog always has a workout in hand) fills it in. Cascades with
  // the plan — its history goes with it, same as everything else under Cycle.
  cycleId String?
  cycle   Cycle?  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  workoutId       String?
  workoutDate     DateTime?
  weekNumber      Int?
  dayNumber       Int?
  exerciseEntryId String?
  exerciseName    String

  // "set-updated" | "set-removed" | "exercise-added" | "exercise-removed"
  kind       String
  setEntryId String?
  setNumber  Int?
  // "weight" | "reps" — only set when kind is "set-updated"
  field       String?
  beforeValue Float?
  afterValue  Float?

  actorId String
  // "COACH" | "ATHLETE" — always "ATHLETE" today (recordChangeLog is only
  // ever called for athlete-made edits), kept generic in case that changes.
  actorRole String

  // Flips to true once the coach has viewed it (History screen or the
  // workout it happened on) — drives the "new" highlight until then.
  seenByCoach Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([athleteId, createdAt])
  @@index([cycleId, createdAt])
  @@index([workoutId])
  @@index([exerciseEntryId, setEntryId])
}
