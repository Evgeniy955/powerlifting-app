DATABASE_URL="postgresql://user:password@localhost:5432/powerlifting?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that should be provisioned as COACH on first sign-in
COACH_EMAILS="coach@example.com"

# AI-рекомендации на странице аналитики (Этап 5). Опционально — без ключа
# кнопка "Получить рекомендации" покажет понятное сообщение вместо ошибки.
# Получить ключ: console.anthropic.com
ANTHROPIC_API_KEY=""

# Email-приглашения атлетам и уведомления тренеру об изменениях (Resend).
# Опционально — без ключа отправка приглашения вернёт понятную ошибку вместо
# падения, а уведомления тренеру молча не отправятся (это не должно ломать
# сохранение данных атлета). Получить ключ: resend.com
RESEND_API_KEY=""
# Отправитель писем — нужен подтверждённый домен в Resend. Если оставить
# пустым, письма уходят с их sandbox-адреса (только на тестовые адреса вашего
# аккаунта Resend, не подойдёт для реальных приглашений).
RESEND_FROM_EMAIL=""
