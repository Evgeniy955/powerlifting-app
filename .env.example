# Prisma (server-side only) — both connection strings from Supabase
# Dashboard -> Project Settings -> Database -> Connect -> ORMs -> Prisma tab.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase Auth / Storage / Realtime — Project Settings -> Data API / API Keys.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Google OAuth is configured inside Supabase (Dashboard -> Authentication ->
# Sign In / Providers -> Google) — not as app env vars here. Redirect URI in
# Google Cloud Console: https://xxxxx.supabase.co/auth/v1/callback

# Comma-separated emails that should be provisioned as COACH on first sign-in
COACH_EMAILS="coach@example.com"

# AI-рекомендации на странице аналитики (Этап 5). Опционально — без ключа
# кнопка "Получить рекомендации" покажет понятное сообщение вместо ошибки.
# Получить ключ: console.anthropic.com
ANTHROPIC_API_KEY=""

# Email-приглашения атлетам и уведомления тренеру об изменениях — отправка
# идёт через SMTP обычной Gmail-почты, не нужен домен или платный сервис.
# Опционально — без переменных отправка приглашения вернёт понятную ошибку
# вместо падения, а уведомления тренеру молча не отправятся (это не должно
# ломать сохранение данных атлета).
#   1) Включи двухфакторную аутентификацию: myaccount.google.com/security
#   2) Создай пароль приложения: myaccount.google.com/apppasswords ->
#      "Другое (укажите название)" -> впиши, например, IronLedger -> Создать
#   3) Скопируй показанный 16-значный пароль сюда без пробелов
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD=""

# Ссылка "Принять приглашение" внутри письма ведёт сюда + /login?invite=...
# Опционально — на Vercel домен подставляется сам (production-домен проекта,
# без какой-либо настройки). Задавайте только если нужен другой домен, чем
# тот, что Vercel считает основным.
NEXT_PUBLIC_APP_URL=""
